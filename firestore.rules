rules_version = '2';
// Firestore security rules for Summoner: Hellbound Grimoire.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // cloud saves: each player can only read and write their own save
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }
    // leaderboards: anyone can read; players can only write their own entry
    match /boards/{board}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.score is number && request.resource.data.score >= 0
                   && request.resource.data.name is string && request.resource.data.name.size() <= 16;
    }
    // arena: signed-in players can read loadouts to fight them; each player writes only their own
    match /arena/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.deck is list && request.resource.data.deck.size() <= 6
                   && request.resource.data.rating is number;
    }
  }
}
